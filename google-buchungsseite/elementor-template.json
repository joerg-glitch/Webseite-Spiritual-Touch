        {
          "id": "d72e6c9",
          "elType": "widget",
          "settings": {
            "html": "<!-- ============================================================\n  Google-Buchungsseite – FUSS (Elementor HTML-Widget, unterstes Widget)\n  ============================================================ -->\n<style>\n  .stg-foot{ text-align:center; padding:8px 4px 40px; font-size:14px; line-height:1.7; color:#4A4442; }\n  .stg-foot p{ margin:0 0 14px !important; color:#4A4442 !important; font-size:14px !important; }\n  .stg-foot a{ color:#5B4338 !important; text-decoration:underline; text-underline-offset:3px; }\n  .stg-foot a:hover{ color:#9A4A4A !important; }\n\n  .stg-contact{ display:flex; flex-wrap:wrap; gap:10px; justify-content:center; margin:0 0 22px; }\n  .stg-contact a{\n    display:inline-block; text-decoration:none !important;\n    padding:10px 18px; border-radius:999px;\n    background:#C8B178; color:#2E2420 !important; border:1px solid #C8B178;\n    font-size:14px; font-weight:600;\n  }\n  .stg-contact a.stg-ghost{ background:transparent; color:#2E2420 !important; border-color:#5B4338; }\n  .stg-contact a:hover{ filter:brightness(.96); }\n\n  .stg-legal{ font-size:12.5px !important; color:#7A7A7A !important; }\n  .stg-legal a{ color:#7A7A7A !important; }\n</style>\n\n<footer class=\"stg-foot\">\n  <p>Noch eine Frage vor der Buchung?</p>\n  <div class=\"stg-contact\">\n    <a href=\"https://wa.me/4915781504469?text=Hallo%20Spiritual%20Touch%2C%20ich%20habe%20eine%20kurze%20Frage%3A%20\" target=\"_blank\" rel=\"noopener\">WhatsApp schreiben</a>\n    <a class=\"stg-ghost\" href=\"tel:+4915781504469\">Anrufen</a>\n  </div>\n  <p>\n    <a href=\"https://spiritual-touch.de/praxis/honorare/\" target=\"_blank\" rel=\"noopener\">Preise</a> ·\n    <a href=\"https://spiritual-touch.de/praxis/faq/\" target=\"_blank\" rel=\"noopener\">FAQ</a> ·\n    <a href=\"https://spiritual-touch.de/\" target=\"_blank\" rel=\"noopener\">Zur Website</a>\n  </p>\n  <p class=\"stg-legal\">\n    <a href=\"https://spiritual-touch.de/impressum/\" target=\"_blank\" rel=\"noopener\">Impressum</a> ·\n    <a href=\"https://spiritual-touch.de/datenschutzerklaerung/\" target=\"_blank\" rel=\"noopener\">Datenschutz</a>\n  </p>\n</footer>\n",
            "_css_classes": "stg-w"
          },
