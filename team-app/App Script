// ── Eintrittspunkt ──────────────────────────────────────
function doPost(e) {
  try {
    const data = JSON.parse(e.postData.contents);
    if (data.secret !== SECRET) return json({error: 'unauthorized'});

    const member = getByPin(data.pin);
    if (!member) return json({error: 'wrong_pin'});

    switch (data.action) {
      case 'list':   return json({ok: true, name: member.name, entries: listEntries(member.name)});
      case 'create': return json({ok: true, id: createEntry(member.name, data.date, data.from, data.to, data.allDay)});
      case 'update': return json({ok: updateEntry(member.name, data.id, data.date, data.from, data.to, data.allDay)});
      case 'delete': return json({ok: deleteEntry(member.name, data.id)});
      default:       return json({error: 'unknown_action'});
    }
  } catch (error) {
    // Wenn ein Fehler passiert, MUSS Google das im JSON-Format erfahren:
    return json({
      error: "internal_catch_error",
      details: error.toString()
    });
  }
}

