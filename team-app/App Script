// ── Kalender ────────────────────────────────────────────
// Zuordnung/Zeiten liegen als Apps-Script-Tags am Event (setTag/getTag) —
// unsichtbar für den Nutzer, robuster als Text in der Beschreibung zu
// parsen, und derselbe Mechanismus, den der Verfügbarkeit-Sync nutzt.
function listEntries(name) {
  const cal   = CalendarApp.getCalendarById(CAL_ID);
  const start = new Date();
  const end   = new Date();
  end.setDate(end.getDate() + 60); // reicht zum Bearbeiten/Planen, hält die Abfrage bei jedem Login/Speichern klein

  return cal.getEvents(start, end)
    .filter(ev => getMember(ev) === name)
    .map(ev => {
      const from = ev.getTag('from');
      const to   = ev.getTag('to');
      return {
        id:     ev.getId(),
        date:   fmt(ev.getStartTime(), 'yyyy-MM-dd'),
        from:   from || '',
        to:     to   || '',
        allDay: !(from && to)
      };
    });
}

// Echte Amelia-Termine aus dem persönlichen Hilfskalender des Mitglieds —
// Grundlage sowohl für die reine Anzeige als auch fürs Ändern (der
// "appointmentId"-Wert hier ist die echte Amelia-Termin-ID aus der von
// Amelia geschriebenen Beschreibung, nötig für rescheduleAppointment()
// unten). Blendet die eigenen "autoBlock"-Platzhalter des
// Verfügbarkeit-Syncs aus (Tag autoBlock=true) — das sind keine echten
// Termine.
function listAppointments(name) {
  const calId = HELPER_CAL_IDS[name];
  if (!calId) return []; // Person hat (noch) keinen Hilfskalender hinterlegt

  const cal   = CalendarApp.getCalendarById(calId);
  const start = new Date();
  const end   = new Date();
  end.setDate(end.getDate() + 90);

  return cal.getEvents(start, end)
    .filter(ev => ev.getTag('autoBlock') !== 'true')
    .map(ev => {
      const desc = ev.getDescription() || '';
      const idMatch   = desc.match(/Termin-ID:\s*(\d+)/i);
      const nameMatch = desc.match(/Vorname:\s*(.+)/i);
      return {
        id:            ev.getId(),
        appointmentId: idMatch ? idMatch[1] : null, // fehlt bei sehr alten Terminen ohne die Vorlagenzeile -> dann kein Ändern möglich
        date:          fmt(ev.getStartTime(), 'yyyy-MM-dd'),
        from:          fmt(ev.getStartTime(), 'HH:mm'),
        to:            fmt(ev.getEndTime(), 'HH:mm'),
        title:         ev.getTitle(),
        customerName:  nameMatch ? nameMatch[1].trim() : '',
        allDay:        ev.isAllDayEvent()
      };
    })
    .sort((a, b) => (a.date + a.from).localeCompare(b.date + b.from));
}

// Ändert Datum/Uhrzeit eines eigenen Termins direkt in Amelia — über
// denselben internen Amelia-Endpunkt, den auch Jörgs Buchungs-Dashboard
// benutzt (WordPress-Route /booking-reschedule), NICHT durch Bearbeiten
// des Kalender-Termins selbst (der wird von Amelia sowieso neu
// geschrieben, sobald die Änderung durch ist).
//
// Sicherheit: appointmentId kommt vom Client — bevor irgendetwas nach
// Amelia geschickt wird, wird deshalb geprüft, dass genau diese Termin-ID
// gerade wirklich im EIGENEN Hilfskalender dieses Mitglieds auftaucht.
// Ohne diese Prüfung könnte ein manipulierter Request fremde Termine
// verändern.
function rescheduleAppointment(name, appointmentId, date, from, to) {
  if (!appointmentId || !date || !from || !to) {
    return json({ok: false, error: 'missing_params'});
  }
  if (to <= from) {
    return json({ok: false, error: 'end_before_start'});
  }

  const ownEvent = listAppointments(name).find(a => a.appointmentId === String(appointmentId));
  if (!ownEvent) {
    return json({ok: false, error: 'not_your_appointment'});
  }

  const newStartUtc = localToUtcMysql_(date, from);
  const newEndUtc   = localToUtcMysql_(date, to);

  try {
    const response = UrlFetchApp.fetch(WP_RESCHEDULE_URL, {
      method: 'post',
      contentType: 'application/json',
      headers: {'X-ST-Reschedule-Secret': WP_RESCHEDULE_SECRET},
      payload: JSON.stringify({
        appointmentId: Number(appointmentId),
        newBookingStart: newStartUtc,
        newBookingEnd: newEndUtc,
      }),
      muteHttpExceptions: true,
    });
    const code = response.getResponseCode();
    if (code < 200 || code >= 300) {
      return json({ok: false, error: 'wordpress_error', detail: response.getContentText()});
    }
    return json({ok: true});
  } catch (err) {
    return json({ok: false, error: 'request_failed', detail: err.toString()});
  }
}

// Wandelt ein Datum+Uhrzeit-Paar in Berliner Ortszeit (aus dem Formular
// des Teammitglieds) in einen UTC-MySQL-String um, wie ihn
// /booking-reschedule erwartet. Bewusst über Utilities.parseDate() statt
// "new Date(string)" — Letzteres interpretiert einen zeitzonenlosen
// ISO-String je nach Laufzeitumgebung uneinheitlich (derselbe Fehlertyp,
// der ursprünglich die 2-Stunden-Zeitzonen-Abweichung im Buchungs-
// Dashboard verursacht hat, siehe dessen README).
function localToUtcMysql_(dateStr, timeStr) {
  const d = Utilities.parseDate(dateStr + ' ' + timeStr, TIMEZONE, 'yyyy-MM-dd HH:mm');
  return Utilities.formatDate(d, 'Etc/UTC', 'yyyy-MM-dd HH:mm:ss');
}

// Alle Einträge sind Ganztages-Events (bessere Sichtbarkeit im Kalender).
// Bei Teilverfügbarkeit steht die Uhrzeit zusätzlich im Titel.
function createEntry(name, date, from, to, allDay) {
  const cal = CalendarApp.getCalendarById(CAL_ID);
  let event;
  if (allDay) {
    event = cal.createAllDayEvent(name, new Date(date + 'T12:00:00'));
  } else {
    const title = name + ' ' + from + '–' + to + ' Uhr';
    event = cal.createAllDayEvent(title, new Date(date + 'T12:00:00'));
    event.setTag('from', from);
    event.setTag('to', to);
  }
  event.setTag('member', name);
  event.setTransparency(CalendarApp.EventTransparency.TRANSPARENT);
  return event.getId();
}

// Ganztägig-Status kann sich beim Ändern ändern (z.B. Uhrzeit -> Ganztägig) —
// dafür alten Eintrag löschen und mit den neuen Werten neu anlegen statt
// setTime() zu verwenden (funktioniert bei Ganztages-Events nicht sauber).
function updateEntry(name, id, date, from, to, allDay) {
  const ev = safeGet(name, id);
  if (!ev) return false;
  ev.deleteEvent();
  createEntry(name, date, from, to, allDay);
  return true;
}

function deleteEntry(name, id) {
  const ev = safeGet(name, id);
  if (!ev) return false;
  ev.deleteEvent();
  return true;
}

// Sicherheit: Gehört das Event wirklich dieser Person?
function safeGet(name, id) {
  const ev = CalendarApp.getCalendarById(CAL_ID).getEventById(id);
  return (ev && getMember(ev) === name) ? ev : null;
}

// Fallback auf den Titel für alte, manuell angelegte Ganztages-Einträge
// ohne "member"-Tag (Titel besteht dann nur aus dem Namen).
function getMember(ev) {
  return ev.getTag('member') || ev.getTitle();
}

// ── Hilfsfunktionen ─────────────────────────────────────
function getByPin(pin) {
  const rows = SpreadsheetApp.openById(SHEET_ID)
    .getSheetByName('Tabellenblatt1').getDataRange().getValues();
  for (let i = 1; i < rows.length; i++) {
    if (String(rows[i][2]).trim() === String(pin).trim())
      return { name: rows[i][0], email: rows[i][1] };
  }
  return null;
}

function fmt(date, pattern) {
  return Utilities.formatDate(date, TIMEZONE, pattern);
}

function json(data) {
  return ContentService
    .createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}
