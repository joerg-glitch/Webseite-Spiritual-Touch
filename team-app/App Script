// ── Kalender ────────────────────────────────────────────
function listEntries(name) {
  const cal   = CalendarApp.getCalendarById(CAL_ID);
  const start = new Date();
  const end   = new Date();
  end.setMonth(end.getMonth() + 6);

  return cal.getEvents(start, end)
    .filter(ev => getMember(ev) === name)
    .map(ev => {
      const allDay = ev.isAllDayEvent();
      const info   = parseDesc(ev.getDescription());
      return {
        id:     ev.getId(),
        date:   fmt(ev.getStartTime(), 'yyyy-MM-dd'),
        from:   allDay ? '' : (info.from || ''),
        to:     allDay ? '' : (info.to   || ''),
        allDay: allDay
      };
    });
}

// Alle Einträge sind Ganztages-Events (bessere Sichtbarkeit im Kalender).
// Bei Teilverfügbarkeit steht die Uhrzeit im Titel, die Zeiten liegen
// zusätzlich strukturiert in der Beschreibung (robuster als Titel-Parsing).
function createEntry(name, date, from, to, allDay) {
  const cal = CalendarApp.getCalendarById(CAL_ID);
  let event;
  if (allDay) {
    event = cal.createAllDayEvent(name, new Date(date + 'T12:00:00'));
    event.setDescription('member:' + name);
  } else {
    const title = name + ' ' + from + '–' + to + ' Uhr';
    event = cal.createAllDayEvent(title, new Date(date + 'T12:00:00'));
    event.setDescription('member:' + name + ';from:' + from + ';to:' + to);
  }
  event.setTransparency(CalendarApp.EventTransparency.TRANSPARENT);
  return event.getId();
}

// Ganztägig-Status kann sich beim Ändern ändern (z.B. Uhrzeit -> Ganztägig) —
// dafür alten Eintrag löschen und mit den neuen Werten neu anlegen statt
// setTime() zu verwenden (funktioniert bei Ganztages-Events nicht sauber).
function updateEntry(name, id, date, from, to, allDay) {
  const ev = safeGet(name, id);
  if (!ev) return false;
  ev.deleteEvent();
  createEntry(name, date, from, to, allDay);
  return true;
}

function deleteEntry(name, id) {
  const ev = safeGet(name, id);
  if (!ev) return false;
  ev.deleteEvent();
  return true;
}

// Sicherheit: Gehört das Event wirklich dieser Person?
function safeGet(name, id) {
  const ev = CalendarApp.getCalendarById(CAL_ID).getEventById(id);
  return (ev && getMember(ev) === name) ? ev : null;
}

// Liest die Person aus der Beschreibung (member:Name), Fallback auf den
// Titel für alte, manuell angelegte Ganztages-Einträge ohne Tag.
function getMember(ev) {
  const info = parseDesc(ev.getDescription());
  return info.member || ev.getTitle();
}

function parseDesc(desc) {
  const out = {};
  (desc || '').split(';').forEach(part => {
    const idx = part.indexOf(':');
    if (idx > -1) out[part.slice(0, idx).trim()] = part.slice(idx + 1).trim();
  });
  return out;
}

// ── Hilfsfunktionen ─────────────────────────────────────
function getByPin(pin) {
  const rows = SpreadsheetApp.openById(SHEET_ID)
    .getSheetByName('Tabellenblatt1').getDataRange().getValues();
  for (let i = 1; i < rows.length; i++) {
    if (String(rows[i][2]).trim() === String(pin).trim())
      return { name: rows[i][0], email: rows[i][1] };
  }
  return null;
}

function fmt(date, pattern) {
  return Utilities.formatDate(date, TIMEZONE, pattern);
}

function json(data) {
  return ContentService
    .createTextOutput(JSON.stringify(data))
    .setMimeType(ContentService.MimeType.JSON);
}
