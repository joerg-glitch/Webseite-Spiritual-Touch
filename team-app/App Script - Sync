// ── Haupteinstieg (per Trigger aufgerufen) ─────────────────────────
function syncAvailabilityToHelperCalendars() {
  const availCal   = CalendarApp.getCalendarById(CAL_ID);
  const today      = parsedt(fmt(new Date(), 'yyyy-MM-dd'), '00:00');
  const horizonEnd = new Date(today.getTime());
  horizonEnd.setDate(horizonEnd.getDate() + SYNC_DAYS_AHEAD);

  // 1. Verfügbarkeit-Einträge lesen und je Person/Tag zusammenfassen
  const byMemberDay = {};
  availCal.getEvents(today, horizonEnd).forEach(ev => {
    const info = matchMember(ev);
    if (!info) return;
    eachDateInEvent(ev).forEach(d => {
      if (!byMemberDay[info.member]) byMemberDay[info.member] = {};
      byMemberDay[info.member][d] = info; // letzter gelesener Eintrag pro Tag gewinnt
    });
  });

  // 2. Jeden Hilfskalender für den Zeithorizont abgleichen
  Object.keys(MEMBER_CALENDARS).forEach(member => {
    const helperCal = CalendarApp.getCalendarById(MEMBER_CALENDARS[member]);
    for (let i = 0; i < SYNC_DAYS_AHEAD; i++) {
      const d = new Date(today.getTime());
      d.setDate(d.getDate() + i);
      const dateStr = fmt(d, 'yyyy-MM-dd');
      const avail   = (byMemberDay[member] && byMemberDay[member][dateStr]) || null;
      reconcileDay(helperCal, member, dateStr, computeNeededBlocks(avail));
    }
  });
}

// ── Regel: Verfügbarkeit → nötige Blocker ──────────────────────────
function computeNeededBlocks(avail) {
  if (!avail) return [{ start: WORK_START, end: WORK_END }];         // kein Eintrag -> ganzer Tag blockiert
  if (avail.allDay) return [];                                       // ganztägig verfügbar -> kein Blocker
  const blocks = [];
  const from = avail.from || WORK_START;
  const to   = avail.to   || WORK_END;
  if (from > WORK_START) blocks.push({ start: WORK_START, end: from });
  if (to   < WORK_END)   blocks.push({ start: to,          end: WORK_END });
  return blocks;
}

// Vorhandene Sync-Blocker dieses Tages löschen und neu anlegen.
// Fasst nie Events an, die nicht "autoBlock:true" tragen (echte Amelia-Buchungen bleiben unberührt).
function reconcileDay(helperCal, member, dateStr, neededBlocks) {
  const dayStart = parsedt(dateStr, '00:00');
  const dayEnd   = parsedt(dateStr, '23:59');
  helperCal.getEvents(dayStart, dayEnd)
    .filter(ev => {
      const info = parseDesc(ev.getDescription());
      return info.autoBlock === 'true' && info.sourceDate === dateStr;
    })
    .forEach(ev => ev.deleteEvent());

  neededBlocks.forEach(b => {
    const ev = helperCal.createEvent('Blockiert (Verfügbarkeit-Sync)', parsedt(dateStr, b.start), parsedt(dateStr, b.end));
    ev.setDescription('autoBlock:true;sourceDate:' + dateStr + ';member:' + member);
  });
}

// ── Verfügbarkeit-Event einer Person zuordnen ──────────────────────
// Neues Format (aktueller Team-App-Code): description "member:Name" bzw. "member:Name;from:HH:MM;to:HH:MM"
// Legacy (alte manuelle Einträge ohne Tag): Name als Präfix im Titel + Freitext-Zeitangabe.
function matchMember(ev) {
  const desc = parseDesc(ev.getDescription());
  if (desc.member && MEMBER_CALENDARS[desc.member]) {
    return { member: desc.member, allDay: !(desc.from && desc.to), from: desc.from || null, to: desc.to || null };
  }
  const title = ev.getTitle() || '';
  for (const name in MEMBER_CALENDARS) {
    if (title === name) return { member: name, allDay: true, from: null, to: null };
    if (title.indexOf(name + ' ') === 0 || title.indexOf(name + '(') === 0) {
      const times = parseLegacyTimes(title.slice(name.length));
      if (times.from || times.to) return { member: name, allDay: false, from: times.from, to: times.to };
      return { member: name, allDay: true, from: null, to: null }; // Name erkannt, keine Zeit -> sicherheitshalber ganztägig
    }
  }
  return null;
}

function parseLegacyTimes(text) {
  const out = {};
  let m = text.match(/ab\s*(\d{1,2})[:.](\d{2})/i) || text.match(/^\D*(\d{1,2})[:.](\d{2})\s*-/);
  if (m) out.from = pad(m[1]) + ':' + m[2];
  else if (m = text.match(/ab\s*(\d{1,2})\s*h/i)) out.from = pad(m[1]) + ':00';

  m = text.match(/bis\s*(\d{1,2})[:.](\d{2})/i) || text.match(/-\s*(\d{1,2})[:.](\d{2})/);
  if (m) out.to = pad(m[1]) + ':' + m[2];
  else if (m = text.match(/bis\s*(\d{1,2})\s*h/i) || text.match(/-\s*(\d{1,2})\s*(?:h|Uhr)/i)) out.to = pad(m[1]) + ':00';
  return out;
}
function pad(n) { n = String(n); return n.length < 2 ? '0' + n : n; }

// Mehrtägige Ganztages-Events (z.B. Urlaub über mehrere Tage) auf jeden Tag der Spanne anwenden.
function eachDateInEvent(ev) {
  if (!ev.isAllDayEvent()) return [fmt(ev.getStartTime(), 'yyyy-MM-dd')];
  const dates = [];
  const d   = ev.getAllDayStartDate();
  const end = ev.getAllDayEndDate(); // exklusiv
  while (d < end) {
    dates.push(fmt(d, 'yyyy-MM-dd'));
    d.setDate(d.getDate() + 1);
  }
  return dates;
}

function parseDesc(desc) {
  const out = {};
  (desc || '').split(';').forEach(part => {
    const idx = part.indexOf(':');
    if (idx > -1) out[part.slice(0, idx).trim()] = part.slice(idx + 1).trim();
  });
  return out;
}
function parsedt(dateStr, timeStr) { return Utilities.parseDate(dateStr + ' ' + timeStr, TIMEZONE, 'yyyy-MM-dd HH:mm'); }
function fmt(date, pattern) { return Utilities.formatDate(date, TIMEZONE, pattern); }

// ── Einrichtung ─────────────────────────────────────────
// Einmal manuell ausführen (Dropdown oben im Editor -> "setupHourlyTrigger" -> Ausführen).
// Fragt beim ersten Mal nach Kalender-Berechtigung. Danach läuft der Sync von allein, stündlich.
function setupHourlyTrigger() {
  ScriptApp.getProjectTriggers().forEach(t => {
    if (t.getHandlerFunction() === 'syncAvailabilityToHelperCalendars') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('syncAvailabilityToHelperCalendars').timeBased().everyHours(1).create();
}

// Zum manuellen Testen im Editor (Dropdown -> "runSyncNow" -> Ausführen).
function runSyncNow() { syncAvailabilityToHelperCalendars(); }
