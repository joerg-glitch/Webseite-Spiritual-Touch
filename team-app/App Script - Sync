// ---------- HAUPTFUNKTION (Trigger: stündlich) ----------

function syncAll() {
  var lock = LockService.getScriptLock();
  if (!lock.tryLock(5000)) {
    Logger.log('Ein anderer Sync-Lauf ist bereits aktiv – übersprungen.');
    return;
  }
  try {
    var today = new Date();
    today.setHours(0, 0, 0, 0);

    MEMBERS.filter(function (m) { return m.active; }).forEach(function (member) {
      for (var i = 0; i < SYNC_DAYS; i++) {
        var date = new Date(today.getTime() + i * 24 * 60 * 60 * 1000);
        var businessStart = new Date(date);
        businessStart.setHours(BUSINESS_START_HOUR, 0, 0, 0);
        var businessEnd = new Date(date);
        businessEnd.setHours(BUSINESS_END_HOUR, 0, 0, 0);

        var freeWindows = computeFreeWindows(member.name, date, businessStart, businessEnd);
        var blocked = computeBlockedIntervals(freeWindows, businessStart, businessEnd);
        reconcileDayForMember(member, date, blocked);
      }
    });

    PropertiesService.getScriptProperties().setProperty('lastSuccessRun', new Date().toISOString());
  } catch (err) {
    sendAlert('Fehler im Sync-Lauf', err.message + '\n\n' + err.stack);
    throw err;
  } finally {
    lock.releaseLock();
  }
}

// Manueller Testlauf (Run-Button im Editor) — identisch zu syncAll.
function runSyncNow() {
  syncAll();
}

// ---------- KERNLOGIK ----------

// Liefert die freien Zeitfenster (innerhalb Geschäftszeit) für ein
// Mitglied an einem Tag, basierend auf dessen Einträgen im
// Verfügbarkeit-Kalender. Leeres Array = kein Eintrag vorhanden = nichts frei.
function computeFreeWindows(memberName, date, businessStart, businessEnd) {
  var events = getMatchingEvents(memberName, date);
  if (events.length === 0) {
    return []; // kein Eintrag -> ganzer Tag blockiert
  }

  var intervals = events
    .map(function (e) { return eventFreeWindow(e, businessStart, businessEnd); })
    .filter(function (iv) { return iv !== null; })
    .sort(function (a, b) { return a.start - b.start; });

  if (intervals.length === 0) return []; // nichts auswertbar -> sicherheitshalber blockiert

  var merged = [];
  intervals.forEach(function (iv) {
    var last = merged[merged.length - 1];
    if (last && iv.start <= last.end) {
      if (iv.end > last.end) last.end = iv.end;
    } else {
      merged.push({ start: iv.start, end: iv.end });
    }
  });

  return merged;
}

// Freies Fenster eines einzelnen Verfügbarkeit-Events. null = nicht
// auswertbar (Tag wird dann sicherheitshalber komplett blockiert).
function eventFreeWindow(e, businessStart, businessEnd) {
  // Neues Format (Team-App): from/to-Tags am Ganztages-Event
  var fromTag = e.getTag('from');
  var toTag = e.getTag('to');
  if (fromTag && toTag) {
    return clipToBusinessHours(timeOnDate(businessStart, fromTag), timeOnDate(businessStart, toTag), businessStart, businessEnd);
  }
  if (e.isAllDayEvent()) {
    var title = (e.getTitle() || '').trim();
    var pureNameTitle = MEMBERS.some(function (m) { return title === m.name; });
    if (!pureNameTitle) {
      // Legacy: manuell getippter Ganztages-Eintrag mit Zeit im Titel
      var legacy = parseLegacyTimes(title);
      if (legacy.from || legacy.to) {
        var f = legacy.from || formatHM(businessStart);
        var t = legacy.to || formatHM(businessEnd);
        return clipToBusinessHours(timeOnDate(businessStart, f), timeOnDate(businessStart, t), businessStart, businessEnd);
      }
    }
    return { start: businessStart, end: businessEnd }; // ganztägig verfügbar
  }
  // Legacy: echter Uhrzeit-Termin (vor der Umstellung auf Ganztages-Events angelegt)
  return clipToBusinessHours(e.getStartTime(), e.getEndTime(), businessStart, businessEnd);
}

function timeOnDate(date, hhmm) {
  var parts = hhmm.split(':');
  var d = new Date(date);
  d.setHours(parseInt(parts[0], 10), parseInt(parts[1], 10), 0, 0);
  return d;
}
function formatHM(d) { return Utilities.formatDate(d, TZ, 'HH:mm'); }

function parseLegacyTimes(text) {
  var out = {};
  var m = text.match(/ab\s*(\d{1,2})[:.](\d{2})/i);
  if (m) out.from = pad(m[1]) + ':' + m[2];
  else if (m = text.match(/ab\s*(\d{1,2})\s*h/i)) out.from = pad(m[1]) + ':00';

  m = text.match(/bis\s*(\d{1,2})[:.](\d{2})/i);
  if (m) out.to = pad(m[1]) + ':' + m[2];
  else if (m = text.match(/bis\s*(\d{1,2})\s*h/i)) out.to = pad(m[1]) + ':00';
  return out;
}
function pad(n) { n = String(n); return n.length < 2 ? '0' + n : n; }

function clipToBusinessHours(start, end, businessStart, businessEnd) {
  var s = start < businessStart ? businessStart : start;
  var e = end > businessEnd ? businessEnd : end;
  if (s >= e) return null;
  return { start: s, end: e };
}

// Komplement: Geschäftszeit minus freie Fenster = zu blockierende Fenster
function computeBlockedIntervals(freeWindows, businessStart, businessEnd) {
  var blocked = [];
  var cursor = businessStart;

  freeWindows.forEach(function (fw) {
    if (fw.start > cursor) {
      blocked.push({ start: cursor, end: fw.start });
    }
    if (fw.end > cursor) {
      cursor = fw.end;
    }
  });

  if (cursor < businessEnd) {
    blocked.push({ start: cursor, end: businessEnd });
  }

  return blocked;
}

// Events im Verfügbarkeit-Kalender, die zu diesem Mitglied gehören:
// zuerst über den "member"-Tag, sonst per Namens-Präfix im Titel (alte,
// manuell angelegte Einträge ohne Tag).
function getMatchingEvents(memberName, date) {
  var cal = CalendarApp.getCalendarById(VERFUEGBARKEIT_CAL_ID);
  var events = cal.getEventsForDay(date);
  return events.filter(function (e) { return resolveMember(e) === memberName; });
}

function resolveMember(e) {
  var tagged = e.getTag('member');
  if (tagged) return tagged;
  var title = (e.getTitle() || '').trim();
  for (var i = 0; i < MEMBERS.length; i++) {
    var name = MEMBERS[i].name;
    if (title === name || title.indexOf(name + ' ') === 0 || title.indexOf(name + '(') === 0) return name;
  }
  return null;
}

// Gleicht die gewünschten Blockierungen mit dem Hilfskalender ab.
// Fasst NUR Events an, die selbst als eigener Sync-Blocker erkennbar sind.
function reconcileDayForMember(member, date, blockedIntervals) {
  var cal = CalendarApp.getCalendarById(member.hilfsCalId);
  var dayEvents = cal.getEventsForDay(date);
  var autoEvents = dayEvents.filter(function (e) {
    if (e.getTag(TAG_KEY) === TAG_VALUE) return true;
    var desc = e.getDescription() || '';
    return desc.indexOf('autoBlock:true') > -1; // alte, vor der Tag-Umstellung erzeugte Blocker
  });

  var desiredMap = {};
  blockedIntervals.forEach(function (iv) { desiredMap[intervalKey(iv)] = iv; });

  var matched = {};
  autoEvents.forEach(function (ev) {
    var k = intervalKey({ start: ev.getStartTime(), end: ev.getEndTime() });
    if (desiredMap[k] && ev.getTag(TAG_KEY) === TAG_VALUE) {
      matched[k] = true; // unverändert, kein Schreibzugriff nötig
    } else {
      ev.deleteEvent();
      logRow('DELETE', member.name, date, k);
    }
  });

  blockedIntervals.forEach(function (iv) {
    var k = intervalKey(iv);
    if (!matched[k]) {
      var newEvent = cal.createEvent(BLOCK_TITLE, iv.start, iv.end);
      newEvent.setTag(TAG_KEY, TAG_VALUE);
      newEvent.setTag('sourceDate', Utilities.formatDate(date, TZ, 'yyyy-MM-dd'));
      newEvent.setTag('member', member.name);
      logRow('CREATE', member.name, date, k);
    }
  });
}

function intervalKey(iv) {
  return iv.start.getTime() + '_' + iv.end.getTime();
}

// ---------- LOGGING & ALARM ----------

function logRow(action, memberName, date, detail) {
  try {
    var ss = SpreadsheetApp.openById(ROSTER_SHEET_ID);
    var sheet = ss.getSheetByName(LOG_SHEET_NAME);
    if (!sheet) {
      sheet = ss.insertSheet(LOG_SHEET_NAME);
      sheet.appendRow(['Zeitstempel', 'Mitglied', 'Datum', 'Aktion', 'Details']);
    }
    sheet.appendRow([new Date(), memberName, Utilities.formatDate(date, TZ, 'yyyy-MM-dd'), action, detail]);
  } catch (e) {
    Logger.log('Log-Fehler: ' + e.message);
  }
}

function sendAlert(subject, body) {
  try {
    MailApp.sendEmail(ALERT_EMAIL, '[Verfügbarkeit-Sync] ' + subject, body);
  } catch (e) {
    Logger.log('Mail-Fehler: ' + e.message);
  }
}

// Trigger: alle 3 Stunden. Prüft unabhängig vom Sync selbst, ob überhaupt
// noch erfolgreiche Läufe stattfinden (fängt z.B. gelöschte Trigger,
// aufgebrauchte Quota o.ä. ab).
function checkWatchdog() {
  var props = PropertiesService.getScriptProperties();
  var last = props.getProperty('lastSuccessRun');

  if (!last) {
    sendAlert('Noch kein erfolgreicher Lauf', 'Der Verfügbarkeit-Sync ist seit Einrichtung noch nie erfolgreich durchgelaufen.');
    return;
  }

  var ageMin = (new Date() - new Date(last)) / 60000;
  if (ageMin > WATCHDOG_MAX_AGE_MIN) {
    sendAlert(
      'Kein erfolgreicher Lauf seit ' + Math.round(ageMin) + ' Minuten',
      'Letzter erfolgreicher Lauf: ' + last + '\nBitte Trigger und Ausführungsprotokoll prüfen.'
    );
  }
}
